{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Receita de porte 3D (porte3d, versão 1)",
  "type": "object",
  "required": [
    "versao",
    "id",
    "sprites",
    "pecas",
    "arte"
  ],
  "additionalProperties": false,
  "properties": {
    "versao": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "nota": {
      "type": "string"
    },
    "sprites": {
      "type": "object",
      "required": [
        "S"
      ],
      "additionalProperties": false,
      "properties": {
        "S": {
          "type": "string"
        },
        "E": {
          "type": "string"
        },
        "N": {
          "type": "string"
        },
        "W": {
          "type": "string"
        }
      }
    },
    "tras": {
      "enum": [
        "N",
        "simetrico"
      ],
      "default": "simetrico"
    },
    "material": {
      "type": "string",
      "default": "madeira"
    },
    "cores": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/rgb"
      }
    },
    "pecas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/peca"
      }
    },
    "arte": {
      "type": "object",
      "required": [
        "modo"
      ],
      "additionalProperties": false,
      "properties": {
        "modo": {
          "enum": [
            "adesivo",
            "kit"
          ]
        },
        "recortes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "peca",
              "face",
              "recorte"
            ],
            "additionalProperties": false,
            "properties": {
              "peca": {
                "type": "string"
              },
              "face": {
                "$ref": "#/$defs/face"
              },
              "recorte": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "minItems": 4,
                "maxItems": 4
              },
              "limpar_transparente": {
                "type": "boolean"
              }
            }
          }
        },
        "faces": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "+x",
                "-x",
                "+y",
                "-y",
                "+z",
                "-z",
                "lados"
              ]
            },
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "repetir": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "realista": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "materiais": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "tipo"
            ],
            "properties": {
              "tipo": {
                "enum": [
                  "madeira",
                  "metal",
                  "tecido",
                  "liso"
                ]
              },
              "cor": {
                "$ref": "#/$defs/rgb"
              },
              "desgaste": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "ferrugem": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    },
    "deslocamento_tras": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2,
      "description": "preenchido por preparar.py: deslocamento [dx, dy] do objeto N no tile depois de girar 180 graus"
    }
  },
  "$defs": {
    "rgb": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 255
      },
      "minItems": 3,
      "maxItems": 3
    },
    "vec3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "face": {
      "enum": [
        "+x",
        "-x",
        "+y",
        "-y",
        "+z",
        "-z"
      ]
    },
    "peca": {
      "type": "object",
      "required": [
        "nome",
        "forma"
      ],
      "properties": {
        "nome": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "forma": {
          "enum": [
            "caixa",
            "prisma",
            "cilindro"
          ]
        },
        "material": {
          "type": "string"
        },
        "espelhar": {
          "type": "array",
          "items": {
            "enum": [
              "x",
              "y"
            ]
          },
          "uniqueItems": true
        },
        "rot": {
          "$ref": "#/$defs/vec3"
        },
        "chanfro": {
          "type": "number",
          "minimum": 0
        },
        "veio": {
          "enum": [
            "x",
            "y",
            "z"
          ]
        },
        "tabuas": {
          "type": "integer",
          "minimum": 1
        },
        "min": {
          "$ref": "#/$defs/vec3"
        },
        "max": {
          "$ref": "#/$defs/vec3"
        },
        "afinar": {
          "type": "object",
          "required": [
            "quanto",
            "lados"
          ],
          "additionalProperties": false,
          "properties": {
            "quanto": {
              "type": "number",
              "minimum": 0
            },
            "lados": {
              "type": "array",
              "items": {
                "enum": [
                  "+x",
                  "-x",
                  "+y",
                  "-y"
                ]
              },
              "uniqueItems": true
            }
          }
        },
        "cortes": {
          "type": "array",
          "description": "recortes booleanos de um prisma: cada item e um prisma (perfil, eixo, de, ate) com op diferenca (padrao, fura) ou intersecao (arredonda)",
          "items": {
            "type": "object",
            "required": ["perfil", "eixo", "de", "ate"],
            "properties": {
              "op": {"enum": ["diferenca", "intersecao"]},
              "perfil": {"type": "array", "minItems": 3, "items": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}},
              "eixo": {"enum": ["x", "y"]},
              "de": {"type": "number"},
              "ate": {"type": "number"}
            },
            "additionalProperties": false
          }
        },
        "perfil": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "eixo": {
          "enum": [
            "x",
            "y",
            "z"
          ]
        },
        "de": {
          "type": "number"
        },
        "ate": {
          "type": "number"
        },
        "centro": {
          "$ref": "#/$defs/vec3"
        },
        "raio": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "raio_topo": {
          "type": "number",
          "minimum": 0
        },
        "altura": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "segmentos": {
          "type": "integer",
          "minimum": 3
        },
        "arte_cor": {
          "type": "boolean",
          "description": "no nível arte, usa a cor lisa do material (vidro, transparências) em vez do desenho"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "forma": {
                "const": "caixa"
              }
            }
          },
          "then": {
            "required": [
              "min",
              "max"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "forma": {
                "const": "prisma"
              }
            }
          },
          "then": {
            "required": [
              "perfil",
              "eixo",
              "de",
              "ate"
            ],
            "properties": {
              "eixo": {
                "enum": [
                  "x",
                  "y"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "forma": {
                "const": "cilindro"
              }
            }
          },
          "then": {
            "required": [
              "centro",
              "raio",
              "altura"
            ]
          }
        }
      ]
    }
  }
}
